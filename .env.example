PORT=3000
BASE_URL=http://localhost:3000

# Cheile Stripe de TEST (din Dashboard > Developers > API keys, in modul "Test mode")
STRIPE_SECRET_KEY=
# Generat de comanda "stripe listen --forward-to localhost:3000/api/webhook" (vezi consola dupa rulare)
STRIPE_WEBHOOK_SECRET=

# Optional — daca lipsesc, emailurile sunt doar afisate in consola (nu se trimit)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PureFlame <comenzi@pureflame.ro>
# Adresa unde ajung mesajele din formularul de contact. Daca lipseste, foloseste EMAIL_FROM.
CONTACT_EMAIL=contact@pureflame.ro

# Optional — calea catre fisierul SQLite. Implicit: data/orders.db
DB_PATH=

# Optional — folosite doar de scripts/backup-db.js si scripts/restore-db.js
# BACKUP_ENCRYPTION_KEY: o parola lunga si aleatoare. Fara ea, backup-urile NU sunt criptate.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=
BACKUP_RETENTION_DAYS=30

# Seteaza "production" pe serverul real (dezactiveaza detalii tehnice in raspunsurile de eroare)
NODE_ENV=development
